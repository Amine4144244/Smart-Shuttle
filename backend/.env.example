# ─── Server ───────────────────────────
NODE_ENV=production
PORT=5000

# ─── Supabase (required) ──────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database (Supabase PostgreSQL) ────
# Transaction pooler (port 6543) for application queries:
DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) for Prisma CLI migrations & locks:
DIRECT_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres

# ─── QR Token JWT ─────────────────────
# Used to sign QR code tokens for reservation check-in
QR_SECRET=qr-secret-change-in-production

# ─── Email (optional) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@smartshuttle.com

# ─── App ──────────────────────────────
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
